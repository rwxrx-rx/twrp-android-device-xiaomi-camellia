# NVT touchscreen wake fix
#
# Watch fb0 blank state and re-kick the NVT driver whenever
# the framebuffer transitions from blanked to unblanked.

service nvt_touch_wake_watch /system/bin/sh /system/bin/camellia.touchwake.sh
    class core
    user root
    group root
    seclabel u:r:recovery:s0

on boot
    start nvt_touch_wake_watch
